# PeritAI - Configuración
# Copia este archivo como .env y completa los valores

# OBLIGATORIO: Tu clave de API de Anthropic (Claude)
# Obtenerla en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Configuración del servidor (puedes dejar estos valores)
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Base de datos (SQLite local, no cambiar por ahora)
DATABASE_URL=sqlite+aiosqlite:///./data/peritai.db

# Carpeta de archivos subidos
UPLOAD_DIR=./data/documentos

# Nombre del despacho (aparece en los informes)
NOMBRE_DESPACHO=Despacho Pericial
NOMBRE_PERITO=
EMAIL_PERITO=
TELEFONO_PERITO=
